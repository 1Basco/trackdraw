{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": "./custom-worker.ts",
  "minify": true,
  "upload_source_maps": true,
  "name": "trackdraw",
  "compatibility_date": "2026-03-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
    },
  },
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["17 0 * * *"],
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": false,
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "trackdraw-media",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trackdraw",
      "database_id": "875a18b9-ce1a-4e29-ac76-d0dc950dc574",
    },
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://trackdraw.app",
    "NEXT_PUBLIC_APP_ENV": "production",
    "PLUNK_FROM_EMAIL": "noreply@emails.trackdraw.app",
    "PLUNK_REPLY_TO_EMAIL": "info@trackdraw.app",
  },
  "env": {
    "dev": {
      "minify": false,
      "name": "trackdraw-dev",
      "observability": {
        "enabled": true,
        "logs": {
          "invocation_logs": true,
        },
      },
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "trackdraw-media",
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "trackdraw-dev",
          "database_id": "8b9a4679-c919-4082-93d1-3841fa2bfc19",
        },
      ],
      "vars": {
        "NEXT_PUBLIC_SITE_URL": "https://dev.trackdraw.app",
        "NEXT_PUBLIC_APP_ENV": "development",
        "PLUNK_FROM_EMAIL": "noreply@emails.trackdraw.app",
        "PLUNK_REPLY_TO_EMAIL": "info@trackdraw.app",
      },
    },
    // Fork-only throwaway environment for testing the whoop POC with friends.
    // Uses its own Worker, D1 and R2 in this fork's Cloudflare account so it
    // can never touch the upstream trackdraw.app resources.
    "poc": {
      "minify": false,
      "name": "trackdraw-poc-whoop",
      // Kept on as a fallback URL while the custom domain propagates.
      "workers_dev": true,
      // Requires 1basco.me to be an active zone in this Cloudflare account.
      "routes": [
        {
          "pattern": "whooptrack.1basco.me",
          "custom_domain": true,
        },
      ],
      // No nightly cleanup cron on a throwaway environment.
      "triggers": {
        "crons": [],
      },
      "observability": {
        "enabled": true,
        "logs": {
          "invocation_logs": true,
        },
      },
      // No R2 binding here: gallery preview media is out of scope for this
      // POC, and both call sites treat MEDIA_BUCKET as optional.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "trackdraw-poc",
          "database_id": "dd4e2860-6162-4f57-ac89-7ebd5d880450",
        },
      ],
      "vars": {
        "NEXT_PUBLIC_SITE_URL": "https://whooptrack.1basco.me",
        "NEXT_PUBLIC_APP_ENV": "development",
        "PLUNK_FROM_EMAIL": "noreply@emails.trackdraw.app",
        "PLUNK_REPLY_TO_EMAIL": "info@trackdraw.app",
      },
    },
  },
}
